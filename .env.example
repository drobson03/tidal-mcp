# TIDAL developer app credentials (https://developer.tidal.com/dashboard).
# The catalogue tools use the client-credentials grant. The same app signs
# users in, so add this redirect URI to it once you know the Worker's url:
#   https://<worker>/api/auth/callback/tidal
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# ISO 3166-1 alpha-2 market used for availability when a tool call omits one.
TIDAL_COUNTRY_CODE=US

# Signs sessions and OAuth state, and encrypts stored TIDAL tokens.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Who may connect: TIDAL user ids, usernames or verified emails, separated by
# commas or spaces. Everyone else is turned away after signing in to TIDAL.
ALLOWED_USERS=
